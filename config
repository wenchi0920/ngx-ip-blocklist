ngx_addon_name=ngx_http_blocklist_module

BLOCKLIST_SRCS="\
    $ngx_addon_dir/src/ngx_http_blocklist_module.c \
    $ngx_addon_dir/src/ngx_http_blocklist_l1.c"

BLOCKLIST_DEPS="\
    $ngx_addon_dir/src/ngx_http_blocklist_module.h \
    $ngx_addon_dir/src/ngx_http_blocklist_l1.h"

if test -n "$ngx_module_link"; then
    # Dynamic module build (preferred).
    ngx_module_type=HTTP
    ngx_module_name=ngx_http_blocklist_module
    ngx_module_srcs="$BLOCKLIST_SRCS"
    ngx_module_deps="$BLOCKLIST_DEPS"

    . auto/module
else
    # Static build fallback.
    HTTP_MODULES="$HTTP_MODULES ngx_http_blocklist_module"
    NGX_ADDON_SRCS="$NGX_ADDON_SRCS $BLOCKLIST_SRCS"
    NGX_ADDON_DEPS="$NGX_ADDON_DEPS $BLOCKLIST_DEPS"
fi
